# =========================================================================
# Production Environment Variables
# Copy this file to .env before starting containers: `cp .env.production.example .env`
# =========================================================================

# Database Configuration
POSTGRES_DB=shopify_engine
POSTGRES_USER=shopify_admin
POSTGRES_PASSWORD=replace_with_a_super_strong_random_password_32chars

# Caddy & Domain Configuration
API_DOMAIN=api.yourplatform.com
ACME_EMAIL=your-email@gmail.com

# Cloudflare R2 Backup Credentials (for backup-to-r2.sh cron job)
CF_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=shopify-engine-backups
