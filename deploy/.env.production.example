# =========================================================================
# Production Environment Variables
# Copy this file to .env before starting containers: `cp .env.production.example .env`
# =========================================================================

# Database Configuration
POSTGRES_DB=shopify_engine
POSTGRES_USER=shopify_admin
POSTGRES_PASSWORD=replace_with_a_super_strong_random_password_32chars

# Caddy & Domain Configuration
API_DOMAIN=api.yourplatform.com
ACME_EMAIL=your-email@gmail.com

# =========================================================================
# Cloudflare R2 - Public Media Storage (Product Images, Videos)
# Custom domain: media.istora.online (Publicly accessible)
# =========================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_media_access_key
R2_SECRET_ACCESS_KEY=your_media_secret_key
R2_BUCKET_NAME=apexcommerce
R2_PUBLIC_URL=https://media.istora.online

# =========================================================================
# Cloudflare R2 - STRICTLY PRIVATE Database Backups
# CRITICAL: MUST NOT use 'apexcommerce'. MUST NOT have any public domain.
# API Token MUST be scoped strictly to the backup bucket with Object Read/Write only.
# =========================================================================
R2_BACKUP_ACCOUNT_ID=your_cloudflare_account_id
R2_BACKUP_ACCESS_KEY_ID=your_dedicated_backup_access_key
R2_BACKUP_SECRET_ACCESS_KEY=your_dedicated_backup_secret_key
R2_BACKUP_BUCKET_NAME=istora-db-backups
